# ─── LLM / AI Prompt Space ───────────────────────────────────────────────────
#
# LLM_PROVIDER: which backend to use
#   openai    — OpenAI API (also any OpenAI-compatible cloud provider)
#   ollama    — Local Ollama instance (OpenAI-compatible, no key required)
#   anthropic — Anthropic Messages API (Claude)
#
LLM_PROVIDER=openai

# Base URL for OpenAI-compatible APIs.
# For OpenAI:  https://api.openai.com
# For Ollama:  http://localhost:11434
# Ignored when LLM_PROVIDER=anthropic (Anthropic has a fixed endpoint).
LLM_BASE_URL=http://localhost:11434

# Model name passed to the provider.
# OpenAI examples:    gpt-4o, gpt-4o-mini
# Ollama examples:    llama3, mistral, qwen2.5-coder
# Anthropic examples: claude-sonnet-4-6, claude-haiku-4-5-20251001
LLM_MODEL=llama3

# API key for the selected provider.
# Leave empty for local Ollama (no key required).
LLM_API_KEY=

# ─── PostgreSQL (node-build-server) ──────────────────────────────────────────
#
# Required for Postgres-backed persistence and the Yjs collab state column.
# When not set the server falls back to filesystem persistence (site.json).
# Run `npm run migrate` once after setting this to create the tables.
#
# Format: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voxesiteeditor

# ─── Voice Input / Whisper Transcription (node-build-server) ─────────────────
#
# URL of the local Whisper-compatible ASR HTTP server.
# Supported servers: whisper.cpp HTTP server, faster-whisper, or any server
# that accepts POST /asr with multipart audio and returns { "text": "..." }.
#
# If not set, a mock adapter is used (streams a fake transcript for development).
#
# Examples:
#   whisper.cpp server: http://localhost:9000
#   faster-whisper:     http://localhost:9000
WHISPER_BASE_URL=http://localhost:9000

# ─── Build server (node-build-server) ────────────────────────────────────────
#
# HTTP + WebSocket port of the build server.
PORT=2999

# 32-byte key, as 64 hex characters, used to encrypt form-endpoint credentials
# (AES-256-GCM). Generate one with: openssl rand -hex 32
ENDPOINT_ENCRYPTION_KEY=

# Runtime app URL and shared secret used to purge its product page cache.
RUNTIME_URL=http://localhost:3001
CACHE_PURGE_SECRET=

# ─── Runtime app (apps/runtime) ──────────────────────────────────────────────
#
# Site rendered by the runtime.
SITE_ID=default
