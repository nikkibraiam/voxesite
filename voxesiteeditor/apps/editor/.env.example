# ─── WebSocket base URL (apps/editor) ────────────────────────────────────────
#
# Base WebSocket endpoint for the node-build-server.
# Used by BOTH voice transcription (/transcription) and collaboration (/collaboration).
#
# Default (local dev): ws://localhost:2999
# In production: replace with your deployed build server URL.
NUXT_PUBLIC_WS_URL=ws://localhost:2999
