# ─── Voice Input — WebSocket URL (apps/editor) ───────────────────────────────
#
# WebSocket endpoint for real-time voice transcription.
# Must point to the /transcription path on the node-build-server.
#
# Default (local dev): ws://localhost:2999
# In production: replace with your deployed build server URL.
NUXT_PUBLIC_WS_URL=ws://localhost:2999
